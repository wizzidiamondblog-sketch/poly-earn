<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Poly Earn - My Profile</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#0b0e14] text-white min-h-screen font-sans pb-24">

  <header class="bg-[#121722] border-b border-gray-800 p-4">
    <div class="max-w-4xl mx-auto flex justify-between items-center">
      <a href="{{ url_for('dashboard') }}"
         class="text-xl font-bold text-purple-400">
        Poly Earn
      </a>

      <a href="{{ url_for('dashboard') }}"
         class="text-sm text-gray-300 hover:text-white">
        Dashboard
      </a>
    </div>
  </header>

  <main class="max-w-4xl mx-auto p-4">

    <h1 class="text-2xl font-bold mt-5">My Profile</h1>
    <p class="text-gray-400 mt-2">
      View your account information and balances.
    </p>

    <div class="bg-[#151b28] border border-gray-800 rounded-2xl p-6 mt-6">
      <div class="w-16 h-16 rounded-full bg-purple-600 flex items-center justify-center text-2xl font-bold">
        {{ (user[0] or 'U')[0]|upper }}
      </div>

      <h2 class="text-xl font-bold mt-4">{{ user[0] }}</h2>
      <p class="text-gray-400 text-sm mt-1">{{ user[1] }}</p>

      <div class="border-t border-gray-800 mt-5 pt-5 space-y-4">

        <div class="flex justify-between gap-4">
          <span class="text-gray-400">Username</span>
          <span class="font-medium text-right">{{ user[0] }}</span>
        </div>

        <div class="flex justify-between gap-4">
          <span class="text-gray-400">Email</span>
          <span class="font-medium text-right break-all">{{ user[1] }}</span>
        </div>

        <div class="flex justify-between gap-4">
          <span class="text-gray-400">Points Balance</span>
          <span class="font-bold text-purple-400">{{ user[4] }} points</span>
        </div>

        <div class="flex justify-between gap-4">
          <span class="text-gray-400">USD Balance</span>
          <span class="font-bold text-green-400">${{ "%.2f"|format(user[5]|float) }}</span>
        </div>

        <div class="flex justify-between gap-4">
          <span class="text-gray-400">Referral Code</span>
          <span class="font-medium text-purple-300">{{ user[3] or 'Not available' }}</span>
        </div>

        <div class="flex justify-between gap-4">
          <span class="text-gray-400">Joined</span>
          <span class="font-medium text-right">{{ user[2] or 'Not available' }}</span>
        </div>

      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 mt-5">
      <a href="{{ url_for('redeem') }}"
         class="bg-[#151b28] border border-gray-800 rounded-xl p-4 hover:border-purple-500">
        <p class="font-bold">Redeem Points</p>
        <p class="text-gray-400 text-sm mt-1">Convert points to USD</p>
      </a>

      <a href="{{ url_for('history') }}"
         class="bg-[#151b28] border border-gray-800 rounded-xl p-4 hover:border-purple-500">
        <p class="font-bold">Transaction History</p>
        <p class="text-gray-400 text-sm mt-1">View your activity</p>
      </a>
    </div>

    <a href="{{ url_for('dashboard') }}"
       class="block text-center text-gray-400 mt-8">
      ← Back to Dashboard
    </a>

  </main>

</body>
</html>
